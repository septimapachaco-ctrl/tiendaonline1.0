// Esquema de datos de la tienda (PostgreSQL en Supabase).
// DATABASE_URL: conexión con pooler (puerto 6543) para la app.
// DIRECT_URL: conexión directa (puerto 5432) para crear/actualizar tablas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// role: CUSTOMER | STAFF | ADMIN
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String
  role         String     @default("CUSTOMER")
  createdAt    DateTime   @default(now())
  orders       Order[]
  addresses    Address[]
  seller       Seller?
  questions    Question[]
  reviews      Review[]
}

// Vendedores del marketplace. kind: USADOS (familias que venden lo que ya no usan) | ARTESANO
// status: ACTIVE | SUSPENDED. Los tokens de Mercado Pago se guardan cifrados.
model Seller {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String    @default("USADOS")
  displayName     String
  slug            String    @unique
  bio             String    @default("")
  city            String
  province        String
  handDelivery    Boolean   @default(true)
  status          String    @default("ACTIVE")
  commissionPct   Int? // pisa la comisión general para este vendedor
  mpUserId        String?
  mpAccessToken   String?
  mpRefreshToken  String?
  mpTokenExpires  DateTime?
  acceptedTermsAt DateTime
  createdAt       DateTime  @default(now())
  products        Product[]
  orders          Order[]
  reviews         Review[]
}

// Pregunta pública sobre un producto; se filtran datos de contacto.
model Question {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  answer     String?
  answeredAt DateTime?
  hidden     Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// Calificación del comprador al vendedor, solo para pedidos entregados dentro de la página.
model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // opcional: también califican quienes compraron sin cuenta, desde el enlace privado del pedido
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())
}

// Ajustes editables desde el panel (por ejemplo, comisiones).
model Setting {
  key   String @id
  value String
}

model Address {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  street   String
  city     String
  province String
  zip      String
  notes    String?
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String         @default("")
  price        Int // precio base en pesos
  comparePrice Int? // precio tachado (opcional)
  active       Boolean        @default(true)
  featured     Boolean        @default(false)
  categoryId   String?
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // null = producto de la tienda; si no, publicación de un vendedor del marketplace
  sellerId     String?
  seller       Seller?        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // condition: NUEVO | COMO_NUEVO | BUEN_ESTADO | USO_VISIBLE
  condition    String         @default("NUEVO")
  questions    Question[]
  images       ProductImage[]
  variants     Variant[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

// Cada combinación talle/color con su stock. price opcional pisa el precio base.
model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String?
  color      String?
  sku        String?
  stock      Int         @default(0)
  price      Int?
  orderItems OrderItem[]
}

// type: PERCENT | FIXED
model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String    @default("PERCENT")
  value     Int
  minTotal  Int       @default(0)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  orders    Order[]
}

model ShippingZone {
  id        String  @id @default(cuid())
  name      String
  price     Int
  isPickup  Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  orders    Order[]
}

// status: PENDING | PAID | PREPARING | SHIPPED | DELIVERED | CANCELLED
// deliveryMethod: SHIPPING | HAND (entrega en mano) | PICKUP (retiro en el local de la tienda)
model Order {
  id             String        @id @default(cuid())
  number         Int           @unique
  sellerId       String?
  seller         Seller?       @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  commissionPct  Int           @default(0)
  commission     Int           @default(0)
  deliveryMethod String        @default("SHIPPING")
  deliveryCode   String?
  deliveredAt    DateTime?
  review         Review?
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  name           String
  phone          String
  street         String?
  city           String?
  province       String?
  zip            String?
  notes          String?
  shippingZoneId String?
  shippingZone   ShippingZone? @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  shippingName   String
  shippingCost   Int
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discount       Int           @default(0)
  subtotal       Int
  total          Int
  status         String        @default("PENDING")
  paymentStatus  String?
  paymentId      String?
  paymentMethod  String?
  installments   Int?
  paidAt         DateTime?
  stockApplied   Boolean       @default(false)
  trackingCode   String?
  adminNotes     String?
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantName String
  unitPrice   Int
  quantity    Int
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
