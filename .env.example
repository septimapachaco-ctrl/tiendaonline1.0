# --- Base de datos ---
# Desarrollo: SQLite. Producción: cambiar provider a "postgresql" en prisma/schema.prisma y usar la URL del proveedor.
DATABASE_URL="file:./dev.db"

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Mi Tienda"
NEXT_PUBLIC_WHATSAPP="5491100000000"
# Secreto para firmar sesiones (cadena larga y aleatoria)
AUTH_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"

# --- Usuario administrador inicial (lo crea el seed) ---
ADMIN_EMAIL="admin@mitienda.test"
ADMIN_PASSWORD="admin-dev-1234"

# --- Mercado Pago (Checkout Pro) ---
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""
# Clave secreta de webhooks (Tus integraciones > Webhooks) para validar la firma
MP_WEBHOOK_SECRET=""
MP_MAX_INSTALLMENTS="12"
# Sin MP_ACCESS_TOKEN: "true" aprueba los pagos automáticamente (solo para demos y pruebas)
PAYMENTS_DEMO="false"

# --- Email (SMTP). Si queda vacío, los emails se muestran en la consola ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Mi Tienda <ventas@mitienda.com.ar>"
ADMIN_NOTIFY_EMAIL=""

# --- SEO y analítica ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
