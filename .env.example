# --- Base de datos (Supabase > Connect > ORMs > Prisma) ---
# Conexión con pooler (puerto 6543) que usa la app
DATABASE_URL="postgresql://postgres.REF:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432) para prisma db push
DIRECT_URL="postgresql://postgres.REF:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Fotos de productos (Supabase > Project Settings > API) ---
# Sin estas variables las fotos se guardan en public/uploads (solo sirve con disco persistente)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="productos"

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Mi Pequeña Delfina"
NEXT_PUBLIC_WHATSAPP="5491100000000"
# Secreto para firmar sesiones (cadena larga y aleatoria)
AUTH_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"

# --- Usuario administrador inicial (lo crea el seed) ---
ADMIN_EMAIL="admin@mipequenadelfina.test"
ADMIN_PASSWORD="admin-dev-1234"

# --- Mercado Pago (Checkout Pro) ---
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""
# Clave secreta de webhooks (Tus integraciones > Webhooks) para validar la firma
MP_WEBHOOK_SECRET=""
MP_MAX_INSTALLMENTS="12"
# Marketplace: credenciales de la aplicación (Tus integraciones > tu app > Credenciales de producción).
# Permiten que cada vendedor conecte su Mercado Pago y que la comisión se descuente sola (split de pagos).
# En la app de Mercado Pago, cargá como Redirect URL: https://TU-DOMINIO/api/mercadopago/oauth
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Sin MP_ACCESS_TOKEN: "true" aprueba los pagos automáticamente (solo para demos y pruebas)
PAYMENTS_DEMO="false"

# --- Email (SMTP). Si queda vacío, los emails se muestran en la consola ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Mi Pequeña Delfina <hola@mipequenadelfina.com.ar>"
ADMIN_NOTIFY_EMAIL=""

# --- SEO y analítica ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
